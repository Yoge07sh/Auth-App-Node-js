<%- include('partials/header.ejs')%>
<%- include('partials/navbar.ejs')%>
<div class="container-fluid">
    <div class="row">


            <main class="col-lg-10 col-md-9 ms-sm-auto px-4 py-4">

                <!-- Welcome -->
                <div class="p-4 mb-4 bg-primary text-white rounded shadow-sm">
                    <h2>Welcome, <%= user.firstname %> 👋</h2>
                    <p class="mb-0">
                        Manage your profile and account from your dashboard.
                    </p>
                </div>

                <!-- Cards -->
                <div class="row g-4">

                    <div class="col-lg-4 col-md-6">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title">Profile</h5>
                                <p class="text-muted">
                                    View and update your personal information.
                                </p>

                                <a href="/user/profile" class="btn btn-primary">
                                    View Profile
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title">Security</h5>
                                <p class="text-muted">
                                    Change your password and manage account security.
                                </p>

                                <a href="/user/change-password" class="btn btn-success">
                                    Change Password
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title">Logout</h5>
                                <p class="text-muted">
                                    Sign out securely from your account.
                                </p>

                                <a href="/user/logout" class="btn btn-danger">
                                    Logout
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Account Details -->
                <div class="card mt-5 shadow-sm border-0">
                    <div class="card-header bg-dark text-white">
                        Account Information
                    </div>

                    <div class="card-body">

                        <table class="table table-bordered">

                            <tr>
                                <th>First Name</th>
                                <td>
                                    <%= user.firstname %>
                                </td>
                            </tr>

                            <tr>
                                <th>Last Name</th>
                                <td>
                                    <%= user.lastname %>
                                </td>
                            </tr>

                            <tr>
                                <th>Email</th>
                                <td>
                                    <%= user.email %>
                                </td>
                            </tr>

                            <tr>
                                <th>Role</th>
                                <td>
                                    <%= user.role %>
                                </td>
                            </tr>

                        </table>

                    </div>
                </div>

            </main>

    </div>
</div>

<%- include('partials/footer.ejs')%>